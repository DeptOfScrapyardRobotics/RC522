{
    "name": "dept-of-scrapyard-robotics/rc522",
    "description": "ScrapyardIO Framework extension library that enables SPI, UART and I2C Control of RC522 RFID/NFC Readers on Linux",
    "type": "library",
    "version": "0.1.0",
    "keywords": [
        "io",
        "linux",
        "embedded",
        "i2c",
        "spi",
        "uart",
        "nfc",
        "rfid",
        "rc522"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "dept-of-scrapyard-robotics/rfid": "^0.1.0",
        "dept-of-scrapyard-robotics/scrapyard-io-framework": "^0.1.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "*",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "ScrapyardIO\\Sensors\\RFID\\RC522\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "minimum-stability": "stable"
}
